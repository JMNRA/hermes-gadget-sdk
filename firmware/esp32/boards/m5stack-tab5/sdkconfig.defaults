# Original M5Stack Tab5 (ILI9881C + GT911): display, touch, audio and the
# onboard-ESP32-C6 Wi-Fi transport, experimental.
# Historical unit boot: P4 v1.0, DIO 40 MHz, 16 MB flash, HEX 32 MB PSRAM
# at 200 MHz. The separate local configuration selects the same memory modes
# and pre-v3 silicon with maximum revision 1.99. Not a hardware test of this SDK.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y
CONFIG_ESP32P4_REV_MAX_FULL=199
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_STR=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_M5STACK_TAB5=y

# Compile the P4 SDK's Wi-Fi API dependency and bring the radio up: the
# onboard ESP32-C6 is reached over SDIO through esp_hosted + esp_wifi_remote.
# board.radio_enabled=true lets the normal image initialize Wi-Fi; the display,
# touch, microphone and audio diagnostic modes never call into it, and no image
# starts the transport in the pre-main constructor (main/CMakeLists.txt).
# CONFIG_ESP_HOST_WIFI_ENABLED is not set
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_ENABLED=y
# Pins are set explicitly below, not by a development-board preset.
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
# CONFIG_ESP_HOSTED_SPI_HOST_INTERFACE is not set
# Slot 1 is the P4's C6 slot; slot 0 carries the microSD card the BSP owns.
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
# CONFIG_ESP_HOSTED_SDIO_SLOT_0 is not set
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# CONFIG_ESP_HOSTED_SDIO_1_BIT_BUS is not set
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
# The C6 SDIO map this unit's factory firmware logged at boot: CLK 12, CMD 13,
# D0-D3 11/10/9/8, slave reset 15. It is not ESP-Hosted's P4-dev-board default
# of CLK 18, CMD 19, D0-D3 14-17, reset 54, which this board does not wire.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
# Active high: ESP-Hosted rests this line HIGH and pulses it LOW to reset, then
# leaves it HIGH for card init (sdio_drv.c transport_gpio_reset). That is the
# sequence the factory firmware ran on GPIO[15] and the C6 answered with its
# INIT event, so the resting HIGH releases the module instead of holding it.
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
# CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW is not set
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
# esp-hosted 2.12 pre-allocates its SDIO and common TX mempools before the first
# Wi-Fi call -- from internal RAM, next to this board's display and audio
# buffers. Allocate transport buffers on demand instead, the same reason
# boards/ws-p4-touch-lcd-3.4c gives for its own image.
# CONFIG_ESP_HOSTED_USE_MEMPOOL is not set
# Left on, a transport failure restarts the whole host: with the C6 wiring not
# yet verified physically, a wrong map would reboot this unit in a loop that
# only reflashing ends. Report the failure to the app instead.
# CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE is not set

CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
